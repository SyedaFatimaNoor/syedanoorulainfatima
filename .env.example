# All optional. With no variables the portfolio runs fully, with an honest email-draft enquiry flow.

# Set to the actual production origin before launch, e.g. your own HTTPS domain.
# Enables canonical URLs and a real sitemap. Do not add a made-up URL.
NEXT_PUBLIC_SITE_URL=

# Add only your confirmed professional contact details. Missing values remain labelled placeholders.
NEXT_PUBLIC_LINKEDIN_URL=
# International format, country code included (digits only, no leading zero).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional direct email delivery. Use the host's secret manager; never commit live credentials.
# Without BOTH values, the form prepares a mailto draft and does not claim to send.
RESEND_API_KEY=
# Must use a sender/domain that you have verified with Resend.
CONTACT_FROM_EMAIL=
# Defaults to the public contact address verified from the GitHub profile.
CONTACT_TO_EMAIL=syedanoorfatima610@gmail.com
